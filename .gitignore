# =============================================
# JOB PORTAL — Root .gitignore
# MERN Stack (MongoDB, Express, React, Node.js)
# =============================================

# --------------------------------------------
# Project Documentation (not for source control)
# --------------------------------------------
Project Explanation/

# --------------------------------------------
# Node.js / npm
# --------------------------------------------
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*
package-lock.json
yarn.lock
pnpm-lock.yaml

# --------------------------------------------
# Environment Variables (NEVER commit secrets)
# --------------------------------------------
.env
.env.*
!.env.example
!.env.sample

# --------------------------------------------
# Backend (Express / Node)
# --------------------------------------------
backend/node_modules/
backend/.env
backend/.env.*
backend/logs/
backend/*.log

# --------------------------------------------
# Frontend (React / Vite)
# --------------------------------------------
frontend/node_modules/
frontend/.env
frontend/.env.*
frontend/dist/
frontend/build/
frontend/.vite/
frontend/coverage/

# --------------------------------------------
# Build Outputs
# --------------------------------------------
dist/
build/
out/
.output/

# --------------------------------------------
# OS & Editor Files
# --------------------------------------------

# macOS
.DS_Store
.AppleDouble
.LSOverride
Icon
._*
.Spotlight-V100
.Trashes

# Windows
Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
ehthumbs_vista.db
Desktop.ini
$RECYCLE.BIN/
*.lnk

# Linux
*~

# VSCode
.vscode/
*.code-workspace

# JetBrains IDEs
.idea/
*.iml
*.ipr
*.iws

# Vim
*.swp
*.swo
*~

# Emacs
\#*\#
.\#*

# --------------------------------------------
# Logs & Debugging
# --------------------------------------------
logs/
*.log
*.log.*
pids/
*.pid
*.seed
*.pid.lock

# --------------------------------------------
# Uploads / Static User Files
# --------------------------------------------
uploads/
public/uploads/

# --------------------------------------------
# Miscellaneous
# --------------------------------------------
.cache/
.temp/
.tmp/
*.tgz
*.tar.gz
